# ==========================================
# 🛠️ GUÍA DE ENTORNO PARA DESARROLLADORES
# ==========================================
# PASO 1: Copia este archivo y renómbralo a `.env.local`
# PASO 2: Levanta servicios con Docker (solo BD: `docker compose up -d mongo-next mongo-express-next`, o stack completo: `docker compose up -d`)
# PASO 3: Ejecuta `npm run dev` (si corres Next en tu máquina; con stack completo la app ya va en el contenedor)

# URI para conectar a la base de datos de Docker local
MONGODB_URI=mongodb://localhost:27019/motivem-dataBase
# Secreto aleatorio para encriptar los JWT en entorno local
JWT_SECRET=escribe_aqui_una_contraseña_aleatoria_para_probar_en_local

RESEND_API_KEY=escribe_aqui_tu_api_key

# Supabase (módulo de materiales: bucket "Materiales")
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# URL pública de la app (enlaces en emails de recuperación de contraseña)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional: protege el endpoint /api/cron/recordatorios
# CRON_SECRET=

# ==========================================
# 🚀 PRODUCCIÓN (Vercel)
# ==========================================
# Las variables reales de Producción (Atlas) NO DEBEN ponerse nunca aquí.
# Cuando vayas a desplegar la web online, introdúcelas directamente 
# en el panel web de Vercel (Project > Settings > Environment Variables).
